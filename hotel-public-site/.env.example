# ============================================================================
# Netlify Build-Time Environment Variables for Public Hotel Website
# IMPORTANT: Configure these in Netlify -> Site configuration -> Environment variables
# Do NOT prefix these with VITE_ or REACT_APP_. They are used ONLY at build time
# by scripts/fetch-published-content.mjs and are never bundled into browser JS.
# ============================================================================

PUBLIC_SITE_EXPORT_API_URL="https://your-private-crm-on-render.onrender.com/api/public-site/export"
PUBLIC_SITE_EXPORT_TOKEN="your_strong_shared_export_secret_minimum_32_chars"
