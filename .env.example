# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database Configuration (MySQL / MariaDB via phpMyAdmin)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="sn_travels_visa"
DB_USER="sn_travels_user"
DB_PASSWORD="your_database_password_here"

# Authentication secret
JWT_SECRET="sn_travels_agency_jwt_secret_key_2026"

# Public Hotel Website Publishing & Netlify Integration (Server-Side Only)
# Shared secret token used by Netlify's build script to fetch the published snapshot
PUBLIC_SITE_EXPORT_TOKEN="your_strong_shared_export_secret_minimum_32_chars"

# Netlify Build Hook URL (POST endpoint created in Netlify -> Site configuration -> Build & deploy -> Build hooks)
NETLIFY_BUILD_HOOK_URL=""

# Optional: Netlify Site ID & Personal Access Token for verifying live build completion status in CRM
NETLIFY_SITE_ID=""
NETLIFY_API_TOKEN=""

